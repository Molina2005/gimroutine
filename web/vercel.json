{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/templates/index.html"
    },
    {
      "source":"nav",
      "destination":"/templates/components/navGeneral.html"
    },
    {
      "source": "/(.*)",
      "destination": "https://backend-mabtrosoft-production.up.railway.app/$1"
    }
  ]
}
